{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Vite: Launch Chrome + Debug",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/src",
      "preLaunchTask": "dev",
      "sourceMaps": true,
      "runtimeArgs": ["--start-maximized", "--disable-extensions"],
      "userDataDir": "${workspaceFolder}/.vscode/.chrome-user-data",
      "smartStep": true,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Vite: Attach to running Chrome",
      "type": "chrome",
      "request": "attach",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/src",
      "port": 9222,
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Vitest: Debug current file",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--inspect-brk", "node_modules/vitest/vitest.mjs"],
      "args": ["run", "${relativeFile}", "--no-color"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"],
      "smartStep": true
    }
  ]
}
