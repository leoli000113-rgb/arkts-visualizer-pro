# ArkTS Visualizer AI 代理密钥与配置
# 复制为 .env 并填值，或直接在环境变量里设置（环境变量优先级更高）。

# Claude API 密钥（与你 Claude Code 用的同一个 key）
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# 默认模型（可改）
ANTHROPIC_MODEL=claude-sonnet-5

# 上游 base url：留空走官方 api.anthropic.com。
# 若你的 Claude Code 配置走自定义网关（如 qwen/glm/openai 兼容代理），填这里，形如 https://api.example.com 或 https://api.example.com/v1
ANTHROPIC_BASE_URL=

# hdc 可执行路径：留空则自动探测 DevEco 默认安装路径，最后退回 PATH 中的 hdc
# Windows 示例：C:/Program Files/Huawei/DevEco Studio/sdk/default/openharmony/toolchains/hdc.exe
HDC_BIN=

# hdc 屏幕流帧率（fps，1–15，默认 6）
HDC_FPS=6

# 服务端口
PORT=5174

# 允许的前端来源（CORS）
ORIGIN=http://localhost:5173
