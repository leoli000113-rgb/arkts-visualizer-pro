  "_conversion": {
    "vp_to_inch": 0.00625,
    "vp_to_cssPx": 0.6,
    "px_to_vp": "round(px * 160 / dpi)",
    "rationale": "vp 是设备无关单位，1 vp = 1/160 英寸（与具体设备 dpi 无关）。dpi 只决定『一个屏幕有多少物理像素』即 screenW_vp，而不改变 vp 的物理大小。Web 端按 1 vp = 0.6 CSS px 渲染即可保证与真机物理尺寸一致。"
  },
